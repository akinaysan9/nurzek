# NurZeka Backend - Örnek ortam değişkenleri
# Kopyalayın: cp .env.example .env  ardından değerleri doldurun.

PORT=3001
JWT_SECRET=buraya-en-az-32-karakter-rastgele-anahtar
DB_PATH=./nurzeka.db

# Postgres v2 layer (concept occurrence governance)
DATABASE_URL=postgresql://nurzek:nurzek@localhost:5432/nurzek
PG_POOL_MAX=10
PG_SSL=false

# Optional queue/backoff companion
REDIS_URL=redis://localhost:6379

# Google ile giriş (isteğe bağlı)
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# DeepSeek API - metin sadeleştirme / analiz (isteğe bağlı)
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
