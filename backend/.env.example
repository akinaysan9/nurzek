# NurZeka Backend - Örnek ortam değişkenleri
# Kopyalayın: cp .env.example .env  ardından değerleri doldurun.

PORT=3001
JWT_SECRET=buraya-en-az-32-karakter-rastgele-anahtar
DB_PATH=./nurzeka.db

# Google ile giriş (isteğe bağlı)
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# DeepSeek API - metin sadeleştirme / analiz (isteğe bağlı)
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
