def get_chunk_identity(chunk: dict) -> str:
    metadata = chunk.get("metadata", {}) if isinstance(chunk.get("metadata"), dict) else {}
    return str(chunk.get("id") or metadata.get("id") or metadata.get("original_order_index") or id(chunk))


def get_chunk_canonical_slug(chunk: dict) -> str:
    metadata = chunk.get("metadata", {}) if isinstance(chunk.get("metadata"), dict) else {}
    slug = str(metadata.get("risale_canonical_slug") or metadata.get("risale_slug") or "").strip()
    if slug:
        return slug
    chapter = str(metadata.get("chapter") or chunk.get("chapter") or "").strip()
    return to_slug(chapter)


def get_chunk_book_and_section(chunk: dict) -> tuple[str, str]:
    metadata = chunk.get("metadata", {}) if isinstance(chunk.get("metadata"), dict) else {}
    book = str(metadata.get("book") or chunk.get("book") or "Belirtilmemiş").strip() or "Belirtilmemiş"
    chapter = str(metadata.get("chapter") or chunk.get("chapter") or "Belirtilmemiş").strip() or "Belirtilmemiş"
    return book, chapter


def get_chunk_source_label(chunk: dict) -> str:
    book, chapter = get_chunk_book_and_section(chunk)
    return f"{book} / {chapter}"


def build_source_payload(chunks: list) -> list:
    payload = []
    for chunk in chunks:
        if not isinstance(chunk, dict):
            continue
        metadata = chunk.get("metadata", {}) if isinstance(chunk.get("metadata"), dict) else {}
        book, chapter = get_chunk_book_and_section(chunk)
        text = re.sub(r"\s+", " ", strip_frontmatter(chunk.get("text", ""))).strip()
        source_slug = str(metadata.get("source") or "").replace(".md", "").strip()
        canonical_slug = get_chunk_canonical_slug(chunk)
        payload.append(
            {
                "id": get_chunk_identity(chunk),
                "kitap": book,
                "bolum_adi": chapter,
                "book_slug": canonical_slug or source_slug,
                "chapter_slug": source_slug or canonical_slug,
                "bolum_no": metadata.get("original_order_index", 0),
                "pasaj": (text[:260] + "...") if len(text) > 260 else text,
                "source": source_slug,
            }
        )
    return payload


def build_context(chunks: list) -> str:
    if not chunks:
        return "[KAYNAK BULUNAMADI]"

    selected = chunks[:TOP_K]
    primary_slug = get_chunk_canonical_slug(selected[0]) if selected else ""
    lines = []
    for chunk in selected:
        source = get_chunk_source_label(chunk)
        text = re.sub(r"\s+", " ", strip_frontmatter(chunk.get("text", ""))).strip()
        slug = get_chunk_canonical_slug(chunk)
        if primary_slug and slug == primary_slug:
            lines.append(f"[ANA KAYNAK - {source}]")
        else:
            lines.append(f"[KAVRAMSAL KÖPRÜ (Destekleyici) - {source}]")
        lines.append(text)
        lines.append("")
    return "\n".join(lines).strip()


def sanitize_answer_text(text: str) -> str:
    clean = str(text or "").strip()
    clean = re.sub(r"\n{3,}", "\n\n", clean)
    return clean


def _make_graphrag_embedding_func():
    if state.embedding_model is None:
        raise RuntimeError("Embedding model is not initialized")
    embedding_dim = int(state.embedding_model.get_sentence_embedding_dimension())

    @wrap_embedding_func_with_attrs(embedding_dim=embedding_dim, max_token_size=8192)
    async def _embed(texts: list[str]) -> np.ndarray:
        vectors = state.embedding_model.encode(texts, convert_to_numpy=True)
        return np.asarray(vectors, dtype=np.float32)

    return _embed


async def _graphrag_model_call(prompt, system_prompt=None, **kwargs):
    full_prompt = str(system_prompt or "") + "\n\n" + str(prompt or "")
    response_format = kwargs.get("response_format") or {}

    def _call():
        return client.chat.completions.create(
            model="deepseek-chat",
            messages=[{"role": "user", "content": full_prompt[:12000]}],
            temperature=0.1,
            stream=False,
            response_format=response_format if isinstance(response_format, dict) and response_format else None,
        )

    try:
        resp = await asyncio.to_thread(_call)
        return str(resp.choices[0].message.content or "")
    except Exception as exc:
        logging.warning("GraphRAG LLM call failed: %s", exc)
        if isinstance(response_format, dict) and response_format.get("type") == "json_object":
            return json.dumps({"points": [{"description": "fallback", "score": 0.1}]}, ensure_ascii=False)
        return "fallback"


def init_nano_graphrag():
    state.graphrag = None
    state.graphrag_ready = False

    if GraphRAG is None or QueryParam is None or wrap_embedding_func_with_attrs is None:
        logging.warning("GraphRAG modules unavailable")
        return
    if not os.path.isdir(NANO_GRAPHRAG_WORK_DIR):
        logging.warning("GraphRAG work dir not found: %s", NANO_GRAPHRAG_WORK_DIR)
        return
    if state.embedding_model is None:
        logging.warning("Embedding model unavailable; GraphRAG init skipped")
        return

    try:
        state.graphrag = GraphRAG(
            working_dir=NANO_GRAPHRAG_WORK_DIR,
            enable_local=True,
            enable_naive_rag=False,
            always_create_working_dir=True,
            enable_llm_cache=False,
            embedding_func=_make_graphrag_embedding_func(),
            best_model_func=_graphrag_model_call,
            cheap_model_func=_graphrag_model_call,
        )
        state.graphrag_ready = True
        logging.info("nano-graphrag ready: %s", NANO_GRAPHRAG_WORK_DIR)
    except Exception as exc:
        state.graphrag = None
        state.graphrag_ready = False
        logging.warning("GraphRAG initialization failed: %s", exc)


def _extract_chunk_ids_from_graphrag_context(raw_text: str) -> list:
    ids = []
    seen = set()
    for match in re.findall(r"\[CHUNK_ID:(\d+)\]", str(raw_text or "")):
        try:
            idx = int(match)
        except Exception:
            continue
        if idx in seen:
            continue
        seen.add(idx)
        ids.append(idx)
    return ids


def _is_general_theme_query(query: str) -> bool:
    q = normalize_for_match(query)
    if not q:
        return True

    words = q.split()
    generic_patterns = [
        "nedir",
        "ne demek",
        "anlami nedir",
        "tanimi",
        "aciklar misin",
        "acikla",
    ]
    specific_markers = [
        "risalesi",
        "risalesinin",
        "mektup",
        "lem",
        "sua",
        "dustur",
        "mahiyeti",
        "bahsi",
        "bolum",
        "dorduncu",
        "ene",
    ]

    if any(marker in q for marker in specific_markers):
        return False
    if re.search(r"\d", q):
        return False

    for token in words:
        if token in state.risale_lookup:
            return False

    if any(pattern in q for pattern in generic_patterns) and len(words) <= 8:
        return True
    return len(words) <= 3


def _route_query_mode(query: str) -> str:
    return "global" if _is_general_theme_query(query) else "local"


async def _query_graphrag_mode_with_resilience(query: str, mode: str, top_k: int) -> list:
    last_error = None
    for attempt in range(1, GRAPH_QUERY_MAX_RETRIES + 2):
        try:
            param = QueryParam(mode=mode, only_need_context=True, top_k=top_k)
            context_text = await asyncio.wait_for(
                asyncio.to_thread(state.graphrag.query, query, param),
                timeout=GRAPH_QUERY_TIMEOUT_SEC,
            )
            return _extract_chunk_ids_from_graphrag_context(context_text)
        except Exception as exc:
            last_error = exc
            if attempt <= GRAPH_QUERY_MAX_RETRIES:
                delay = GRAPH_QUERY_BACKOFF_SEC * (2 ** (attempt - 1))
                logging.warning(
                    "GraphRAG %s query attempt %s failed; retrying in %.1fs (%s)",
                    mode,
                    attempt,
                    delay,
                    exc,
                )
                await asyncio.sleep(delay)

    if last_error is not None:
        logging.warning("GraphRAG %s query exhausted retries: %s", mode, last_error)
    return []


async def _query_nano_graphrag_chunk_ids(query: str, top_k: int = TOP_K) -> tuple[list, str]:
    if not state.graphrag_ready or state.graphrag is None:
        return [], "none"

    query_top_k = max(int(top_k * NANO_GRAPHRAG_TOP_K_MULTIPLIER), NANO_GRAPHRAG_MIN_QUERY_TOP_K)
    preferred_mode = _route_query_mode(query)
    mode_order = [preferred_mode, "global" if preferred_mode == "local" else "local"]

    for mode in mode_order:
        chunk_ids = await _query_graphrag_mode_with_resilience(query, mode, query_top_k)
        if chunk_ids:
            return chunk_ids, mode

    return [], "none"


def dedupe_chunks(chunks: list) -> list:
    seen = set()
    deduped = []
    for chunk in chunks or []:
        cid = get_chunk_identity(chunk)
        if cid in seen:
            continue
        seen.add(cid)
        deduped.append(chunk)
    return deduped


def ensure_source_diversity(chunks: list, top_k: int = TOP_K, min_distinct_sources: int = MIN_DISTINCT_SOURCES) -> list:
    ranked = dedupe_chunks(chunks)
    if not ranked:
        return []

    primary_slug = get_chunk_canonical_slug(ranked[0])
    primary = [c for c in ranked if get_chunk_canonical_slug(c) == primary_slug]
    secondary = [c for c in ranked if get_chunk_canonical_slug(c) != primary_slug]

    secondary_by_slug = {}
    for chunk in secondary:
        slug = get_chunk_canonical_slug(chunk)
        if not slug or slug in secondary_by_slug:
            continue
        secondary_by_slug[slug] = chunk

    reserve = min(max(min_distinct_sources - 1, 0), len(secondary_by_slug))
    primary_limit = max(1, top_k - reserve)

    selected = primary[:primary_limit]
    selected.extend(list(secondary_by_slug.values())[:reserve])

    if len(selected) < top_k:
        used_ids = {get_chunk_identity(c) for c in selected}
        for chunk in secondary:
            cid = get_chunk_identity(chunk)
            if cid in used_ids:
                continue
            selected.append(chunk)
            used_ids.add(cid)
            if len(selected) >= top_k:
                break

    return selected[:top_k]


def _keyword_fallback_chunks(query: str, top_k: int = TOP_K) -> list:
    tokens = [t for t in re.findall(r"[a-zA-Z0-9çğıöşüÇĞİÖŞÜ]+", normalize_for_match(query)) if len(t) >= 3]
    if not tokens or not state.chunks:
        return []

    scored = []
    for idx, chunk in enumerate(state.chunks):
        metadata = chunk.get("metadata", {}) if isinstance(chunk.get("metadata"), dict) else {}
        haystack = " ".join(
            [
                str(metadata.get("book") or ""),
                str(metadata.get("chapter") or ""),
                str(chunk.get("text") or ""),
            ]
        ).lower()
        score = 0
        for token in tokens:
            if token in haystack:
                score += haystack.count(token)
        if score <= 0:
            continue

        item = chunk.copy()
        item["_idx"] = int(idx)
        item["_retrieval"] = "keyword_fallback"
        item["_mode"] = "fallback"
        item["_score"] = float(score)
        scored.append(item)

    scored.sort(key=lambda c: c.get("_score", 0.0), reverse=True)
    diversified = ensure_source_diversity(scored, top_k=top_k, min_distinct_sources=MIN_DISTINCT_SOURCES)
    return dedupe_chunks(diversified)


def _fallback_answer_from_chunks(question: str, chunks: list) -> str:
    if not chunks:
        return "Bu soru için uygun bağlam bulunamadı. [Kaynak: Bulunamadı]"

    lines = [
        "Sistem geçici sorgu yoğunluğu nedeniyle özet cevap fallback kipinde hazırlandı. [Kaynak: Sistem Durumu]",
        f"Soru odağı: {str(question or '').strip()} [Kaynak: Kullanıcı Sorusu]",
    ]
    for chunk in chunks[:3]:
        source = get_chunk_source_label(chunk)
        text = re.sub(r"\s+", " ", strip_frontmatter(chunk.get("text", ""))).strip()
        snippet = text[:260] + ("..." if len(text) > 260 else "")
        lines.append(f"{snippet} [Kaynak: {source}]")
    return "\n".join(lines)


async def _chat_completion_with_resilience(system_prompt: str, user_question: str) -> str:
    last_error = None
    for attempt in range(1, LLM_MAX_RETRIES + 2):
        try:
            def _call():
                return client.chat.completions.create(
                    model="deepseek-chat",
                    messages=[
                        {"role": "system", "content": system_prompt},
                        {"role": "user", "content": user_question},
                    ],
                    stream=False,
                    temperature=get_temperature(user_question),
                    max_tokens=3000,
                )

            resp = await asyncio.wait_for(asyncio.to_thread(_call), timeout=LLM_TIMEOUT_SEC)
            return sanitize_answer_text(resp.choices[0].message.content or "")
        except Exception as exc:
            last_error = exc
            if attempt <= LLM_MAX_RETRIES:
                delay = LLM_BACKOFF_SEC * (2 ** (attempt - 1))
                logging.warning(
                    "Answer generation attempt %s failed; retrying in %.1fs (%s)",
                    attempt,
                    delay,
                    exc,
                )
                await asyncio.sleep(delay)

    raise RuntimeError(f"Answer generation failed after retries: {last_error}")


async def retrieve_chunks(query: str, top_k: int = TOP_K) -> tuple[list, str]:
    if not state.chunks:
        return [], "none"

    ranked_ids, mode = await _query_nano_graphrag_chunk_ids(query, top_k=top_k)
    if not ranked_ids:
        fallback = _keyword_fallback_chunks(query, top_k=top_k)
        if fallback:
            return fallback, "fallback"
        return [], "none"

    out = []
    for rank, idx in enumerate(ranked_ids, start=1):
        if idx < 0 or idx >= len(state.chunks):
            continue
        chunk = state.chunks[idx].copy()
        chunk["_idx"] = int(idx)
        chunk["_retrieval"] = "nano_graphrag"
        chunk["_mode"] = mode
        chunk["_score"] = 1.0 / (10.0 + rank)
        out.append(chunk)
        if len(out) >= max(top_k * 2, 20):
            break
    diversified = ensure_source_diversity(out, top_k=top_k, min_distinct_sources=MIN_DISTINCT_SOURCES)
    return dedupe_chunks(diversified), mode


async def retrieve_relevant_chunks(question: str) -> tuple[list, bool, str]:
    query = str(question or "").strip()
    chunks, mode = await retrieve_chunks(query, top_k=TOP_K)
    if chunks:
        if mode == "local":
            stage = "stage_graphrag_local"
        elif mode == "global":
            stage = "stage_graphrag_global"
        else:
            stage = "stage_failopen_keyword"
        return chunks, True, stage
    return [], False, "stage_graphrag_empty"


@app.on_event("startup")
def startup_event():
    logging.info("Starting NurZeka V2 (GraphRAG-native)...")

    state.embedding_model = SentenceTransformer(EMBEDDING_MODEL_NAME, device="cpu")

    if os.path.exists(METADATA_PATH):
        with open(METADATA_PATH, "rb") as f:
            state.chunks = pickle.load(f)
    else:
        state.chunks = []
        logging.warning("Metadata file not found: %s", METADATA_PATH)

    state.risale_chunk_index = {}
    state.chunk_lookup = {}
    for i, chunk in enumerate(state.chunks or []):
        metadata = chunk.get("metadata", {}) if isinstance(chunk.get("metadata"), dict) else {}
        slug = str(metadata.get("risale_canonical_slug") or metadata.get("risale_slug") or "").strip()
        if not slug:
            slug = to_slug(str(metadata.get("chapter") or ""))
        if slug:
            state.risale_chunk_index.setdefault(slug, []).append(i)

        for key in [chunk.get("id"), metadata.get("id"), str(i)]:
            normalized_key = str(key).strip() if key is not None else ""
            if normalized_key and normalized_key not in state.chunk_lookup:
                state.chunk_lookup[normalized_key] = chunk

    logging.info("Chunk metadata loaded: chunks=%s slugs=%s", len(state.chunks or []), len(state.risale_chunk_index))
    load_risale_sozluk()
    load_aux_lexicons()
    init_nano_graphrag()


class SearchRequest(BaseModel):
    question: str
    conversation_id: Optional[str] = None
    user_id: Optional[str] = None
    book_hint: Optional[str] = None
    chapter_hint: Optional[str] = None
    filter: Optional[dict] = None


@app.post("/api/search")
async def search_endpoint(request: SearchRequest, raw_request: Request):
    user_question = request.question
    chunks, retrieval_is_relevant, retrieval_stage = await retrieve_relevant_chunks(user_question)

    if not chunks:
        chunks = [{"text": "Bu soru için GraphRAG kaynağı bulunamadı.", "metadata": {"book": "Belirtilmemiş", "chapter": "Belirtilmemiş"}}]

    context = build_context(chunks)
    logging.info(
        "REQUEST_RESOLUTION: stage=%s relevant=%s chunks=%s question=%s",
        retrieval_stage,
        retrieval_is_relevant,
        len(chunks),
        user_question,
    )

    async def event_generator():
        filled_prompt = SYSTEM_PROMPT.format(context=context)
        user_id = getattr(raw_request.state, "user_id", None) or request.user_id
        conv_id = request.conversation_id

        try:
            full_response = await _chat_completion_with_resilience(filled_prompt, user_question)
        except Exception as exc:
            logging.error("Streaming answer failed-open activated: %s", exc)
            full_response = _fallback_answer_from_chunks(user_question, chunks)

        try:
            for tok in full_response.split(" "):
                if tok:
                    data = json.dumps({"token": tok + " "}, ensure_ascii=False)
                    yield "data: " + data + "\n\n"
                    await asyncio.sleep(0)

            sources_payload = build_source_payload(chunks[:TOP_K])
            if sources_payload:
                sources_event = json.dumps({"sources": sources_payload}, ensure_ascii=False)
                yield "data: " + sources_event + "\n\n"

            if conv_id and user_id:
                try:
                    db = get_db()
                    db.execute(
                        "INSERT INTO messages (id, conversation_id, user_id, role, content) VALUES (?,?,?,?,?)",
                        [str(uuid.uuid4()), conv_id, user_id, "user", user_question],
                    )
                    db.execute(
                        "INSERT INTO messages (id, conversation_id, user_id, role, content) VALUES (?,?,?,?,?)",
                        [str(uuid.uuid4()), conv_id, user_id, "assistant", full_response],
                    )
                    db.execute(
                        "UPDATE conversations SET updated_at=CURRENT_TIMESTAMP, message_count=message_count+2 WHERE id=?",
                        [conv_id],
                    )
                    db.commit()
                    db.close()
                except Exception as db_err:
                    logging.error("Error saving to DB: %s", db_err)

            yield "data: [DONE]\n\n"
        except Exception as exc:
            err = json.dumps({"error": str(exc)}, ensure_ascii=False)
            yield "data: " + err + "\n\n"

    return StreamingResponse(event_generator(), media_type="text/event-stream")


@app.post("/api/concept-map")
async def get_concept_map(body: dict):
    concept = str(body.get("concept", "")).strip()
    if not concept:
        return {"concept": concept, "nodes": [], "edges": [], "total_chunks": 0}

    chunks, _mode = await retrieve_chunks(concept, top_k=10)
    if not chunks:
        return {"concept": concept, "nodes": [], "edges": [], "total_chunks": 0}

    token_counter = Counter()
    root = normalize_for_match(concept)
    for chunk in chunks:
        tokens = re.findall(r"[A-Za-zÇĞİÖŞÜçğıöşüÂâÎîÛû']+", strip_frontmatter(chunk.get("text", "")))
        for tok in tokens:
            key = normalize_for_match(tok)
            if len(key) < 4 or key == root:
                continue
            token_counter[key] += 1

    kavramlar = [w for w, _ in token_counter.most_common(8)]
    nodes = [
        {
            "id": 0,
            "label": concept.upper(),
            "color": "#c9a84c",
            "size": 30,
            "font": {"size": 14, "bold": True},
        }
    ]
    edges = []
    for i, kavram in enumerate(kavramlar, start=1):
        nodes.append({"id": i, "label": kavram, "color": "#e8d5a3", "size": 20})
        edges.append({"from": 0, "to": i, "width": 2})

    return {
        "concept": concept,
        "nodes": nodes,
        "edges": edges,
        "total_chunks": len(chunks),
    }


@app.post("/api/concept-info")
async def concept_info(body: dict):
    concept = str(body.get("concept", "")).strip()
    if not concept:
        return {
            "concept": concept,
            "count": 0,
            "explanation": "Açıklama alınamadı.",
            "occurrences": [],
            "related_terms": [],
            "stats": {"books": 0, "top_books": []},
        }

    chunks, _mode = await retrieve_chunks(concept, top_k=20)
    occurrences = []
    by_book = Counter()

    for idx, chunk in enumerate(chunks):
        book, chapter = get_chunk_book_and_section(chunk)
        source_slug = get_chunk_canonical_slug(chunk)
        text = re.sub(r"\s+", " ", strip_frontmatter(chunk.get("text", ""))).strip()
        by_book[book] += 1
        occurrences.append(
            {
                "chunk_id": str(idx),
                "kitap": book,
                "bolum_adi": chapter,
                "book_slug": source_slug,
                "chapter_slug": source_slug,
                "bolum_no": idx,
                "pasaj": (text[:140] + "...") if len(text) > 140 else text,
                "metin_ipucu": text[:300],
            }
        )

    ckey = normalize_for_match(concept)
    kavram_item = state.kavram_map.get(ckey)
    ottoman_item = state.ottoman_dict.get(ckey)

    if isinstance(kavram_item, dict) and str(kavram_item.get("baglam") or "").strip():
        explanation = f"KÖK: Kavram sözlüğü\nANLAM: {str(kavram_item.get('baglam')).strip()}"
    elif isinstance(ottoman_item, str) and ottoman_item.strip():
        explanation = f"KÖK: Osmanlıca/Türkçe\nANLAM: {ottoman_item.strip()}"
    else:
        explanation = "KÖK: kavram\nANLAM: Bu kavram için GraphRAG bağlamından özet üretildi."

    related_counter = Counter()
    for chunk in chunks:
        for tok in re.findall(r"[A-Za-zÇĞİÖŞÜçğıöşüÂâÎîÛû']+", strip_frontmatter(chunk.get("text", ""))):
            key = normalize_for_match(tok)
            if len(key) >= 4 and key != ckey:
                related_counter[key] += 1

    related_terms = [{"term": k, "weight": v} for k, v in related_counter.most_common(12)]
    top_books = [{"kitap": k, "count": v} for k, v in by_book.most_common(8)]

    return {
        "concept": concept,
        "count": len(occurrences),
        "explanation": explanation,
        "occurrences": occurrences,
        "related_terms": related_terms,
        "stats": {
            "books": len(by_book),
            "top_books": top_books,
        },
    }