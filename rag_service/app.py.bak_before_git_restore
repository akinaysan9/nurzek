def normalize_alias(value: str) -> str:
    text = str(value or "").strip()
    text = text.replace("İ", "i").replace("I", "i").replace("ı", "i")
    text = text.lower()
    text = "".join(ch for ch in unicodedata.normalize("NFKD", text) if not unicodedata.combining(ch))
    text = text.replace("ğ", "g").replace("ü", "u").replace("ş", "s")
    text = text.replace("ö", "o").replace("ç", "c")
    text = text.replace("â", "a").replace("î", "i").replace("û", "u")
    text = re.sub(r"[^a-z0-9\s]", " ", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text


def normalize_for_match(value: str) -> str:
    return normalize_alias(value)


def to_slug(value: str) -> str:
    text = normalize_alias(value)
    return re.sub(r"\s+", "-", text).strip("-")


def strip_frontmatter(text: str) -> str:
    return re.sub(r"^---[\s\S]*?---\s*", "", text or "").strip()


def load_risale_sozluk():
    state.risale_sozluk = []
    state.risale_lookup = {}
    if not os.path.exists(RISALE_SOZLUK_PATH):
        return

    try:
        with open(RISALE_SOZLUK_PATH, "r", encoding="utf-8") as f:
            payload = json.load(f)
        state.risale_sozluk = payload.get("entries", []) if isinstance(payload, dict) else []

        aliases = payload.get("aliases", {}) if isinstance(payload, dict) else {}
        for alias, mappings in aliases.items():
            key = normalize_for_match(alias)
            if len(key) < 2:
                continue
            state.risale_lookup.setdefault(key, {"exact": set(), "broad": set()})
            for item in mappings or []:
                slug = str(item.get("slug") or "").strip()
                source = str(item.get("source") or "broad").strip().lower()
                if not slug:
                    continue
                if source == "exact":
                    state.risale_lookup[key]["exact"].add(slug)
                else:
                    state.risale_lookup[key]["broad"].add(slug)

        for key in list(state.risale_lookup.keys()):
            exact = sorted(set(state.risale_lookup[key].get("exact", set())))
            broad = sorted(set(state.risale_lookup[key].get("broad", set())) - set(exact))
            state.risale_lookup[key] = {"exact": exact, "broad": broad}

        logging.info("Risale dictionary loaded: entries=%s terms=%s", len(state.risale_sozluk), len(state.risale_lookup))
    except Exception as exc:
        logging.warning("Risale dictionary load failed: %s", exc)


def load_aux_lexicons():
    state.kavram_map = {}
    state.ottoman_dict = {}

    try:
        if os.path.exists(KAVRAMLAR_JSON_PATH):
            with open(KAVRAMLAR_JSON_PATH, "r", encoding="utf-8") as f:
                raw = json.load(f)
            if isinstance(raw, dict):
                state.kavram_map = {normalize_for_match(k): v for k, v in raw.items() if str(k).strip()}
